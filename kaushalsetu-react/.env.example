# Frontend environment variables — copy to `.env` (never commit `.env`).

# Backend API origin. The backend runs on PORT=4000 by default
# (see kaushalsetu-server/.env.example). BOTH of these forms work —
# a trailing `/api` is stripped automatically, paths are appended by the app:
#   VITE_API_BASE_URL=http://localhost:4000
#   VITE_API_BASE_URL=http://localhost:4000/api
# When unset OR the backend is unreachable, the app runs in local
# development auth mode (browser-only demo accounts) and API-backed
# features (profiles, data, AI, reports) show an unavailable state.
VITE_API_BASE_URL=http://localhost:4000

# Auth provider selector (used once the backend runs in Clerk mode).
VITE_AUTH_PROVIDER=local

# Clerk publishable key (public, frontend-safe). When set, "Sign In/Up with
# Clerk" buttons appear on the login page (email/Google/demo auth keep working).
# Get it from https://dashboard.clerk.com → API Keys. Requires the backend's
# CLERK_SECRET_KEY to be set, otherwise exchange fails with a clear error.
VITE_CLERK_PUBLISHABLE_KEY=
