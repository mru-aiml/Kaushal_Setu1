# Frontend environment variables — copy to `.env` (never commit `.env`).

# Backend API base URL. When set AND reachable, the app runs in backend mode
# (real accounts, database, AI gateway, reports). When unset, the app runs in
# local development auth mode (browser-only demo accounts).
VITE_API_BASE_URL=http://localhost:4000

# Auth provider selector (used once the backend runs in Clerk mode).
VITE_AUTH_PROVIDER=local

# Clerk publishable key (public, frontend-safe). Only for future Clerk mode.
VITE_CLERK_PUBLISHABLE_KEY=
