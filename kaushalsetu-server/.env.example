# KAUSHALSETU backend — environment variables.
# Copy to `.env`. NEVER commit `.env` or expose these values in frontend code.

# Server (Render sets PORT automatically; HOST 0.0.0.0 is required there)
PORT=4000
HOST=0.0.0.0
# Public base URL of THIS backend (used for OAuth callbacks)
BACKEND_URL=http://localhost:4000
# Frontend origin(s), comma-separated (CORS + OAuth redirects).
# Production: set BOTH to your Vercel URL, e.g. https://kaushalsetu.vercel.app
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:4174

# --- Database (PostgreSQL 16+) ---
# On Render this is auto-provided by the linked database — do NOT hardcode it.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kaushalsetu
# Individual variables (used only when DATABASE_URL is unset):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kaushalsetu
DB_USER=postgres
DB_PASSWORD=postgres
# Legacy SQLite file (read-only source for `npm run db:migrate:sqlite`).
SQLITE_PATH=./data/kaushalsetu.sqlite

# --- Auth ---
# Session lifetime (days)
SESSION_DAYS=30

# Google OAuth (optional). If unset, Google sign-in is DISABLED with a clear
# message — the app will not pretend it works.
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application"; authorized redirect URI must be
#  ${BACKEND_URL}/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI provider (backend-only; NEVER use VITE_* for these) ---
# AI_PROVIDER: "none" | "openai-compatible"
# "openai-compatible" works with Groq, NVIDIA NIM, OpenRouter, Ollama, etc.
AI_PROVIDER=none
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY= 
AI_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_MS=60000

# --- Storage ---
DATA_DIR=./data
MAX_UPLOAD_BYTES=5242880
